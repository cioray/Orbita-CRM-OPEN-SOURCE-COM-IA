{
  "name": "orbita-crm-community",
  "description": "Local-first conversational CRM with structured AI classification and human-confirmed service finances",
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "worker": "node --env-file=.env --import tsx src/worker.ts",
    "migrate": "node --env-file=.env --import tsx src/migrate.ts",
    "bootstrap": "node scripts/bootstrap.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "bullmq": "6.3.17",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "saxes": "6.0.0",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/yauzl": "3.4.0",
    "jszip": "3.10.1",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
